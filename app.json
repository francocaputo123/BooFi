{
  "expo": {
    "name": "BooFi",
    "slug": "BooFi",
    "scheme" : "BooFi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
        [
          "expo-location",
          {
            "locationWhenInUsePermission": "BooFi usa tu ubicación para mostrarte en el mapa y encontrar bibliotecas cerca."
          }
      ]
    ]
  }
}
